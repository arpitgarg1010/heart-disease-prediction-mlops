    {
      "name": "Incomplete json request body - 422",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 422\", function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "",
              "pm.test(\"Response time is below 500ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});",
              "",
              "pm.test(\"Response is valid JSON\", function () {",
              "    pm.expect(() => pm.response.json()).to.not.throw();",
              "});",
              "",
              "pm.test(\"Validation error response contains details\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.be.an(\"object\");",
              "    pm.expect(Object.keys(json).length).to.be.above(0);",
              "",
              "    const hasDetail = Object.prototype.hasOwnProperty.call(json, \"detail\");",
              "    const hasMessage = Object.prototype.hasOwnProperty.call(json, \"message\");",
              "    const hasError = Object.prototype.hasOwnProperty.call(json, \"error\");",
              "",
              "    pm.expect(hasDetail || hasMessage || hasError).to.equal(true);",
              "});",
              "",
              "pm.test(\"Validation detail is present and non-empty\", function () {",
              "    const json = pm.response.json();",
              "    const detail = json.detail ?? json.message ?? json.error;",
              "",
              "    if (Array.isArray(detail)) {",
              "        pm.expect(detail.length).to.be.above(0);",
              "    } else {",
              "        pm.expect(detail).to.exist;",
              "        pm.expect(String(detail).trim().length).to.be.above(0);",
              "    }",
              "});",
              "",
              "pm.test(\"Validation response does not include prediction result\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.not.have.property(\"prediction\");",
              "    pm.expect(json).to.not.have.property(\"confidence\");",
              "});",
              "",
              "pm.test(\"If detail is an array, at least one item points to a missing or invalid field\", function () {",
              "    const json = pm.response.json();",
              "    const detail = json.detail;",
              "",
              "    if (Array.isArray(detail)) {",
              "        const serialized = JSON.stringify(detail).toLowerCase();",
              "        pm.expect(serialized.length).to.be.above(2);",
              "        pm.expect(",
              "            serialized.includes(\"missing\") ||",
              "            serialized.includes(\"field required\") ||",
              "            serialized.includes(\"invalid\") ||",
              "            serialized.includes(\"type\")",
              "        ).to.equal(true);",
              "    } else {",
              "        pm.expect(true).to.equal(true);",
              "    }",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"age\": 55,\r\n  \"sex\": 1,\r\n  \"cp\": 3,\r\n  \"trestbps\": 135,\r\n  \"fbs\": 0,\r\n  \"restecg\": 1,\r\n  \"thalach\": 145,\r\n  \"exang\": 0,\r\n  \"oldpeak\": 1.5,\r\n  \"slope\": 2,\r\n  \"ca\": 1,\r\n  \"thal\": 6\r\n}",
